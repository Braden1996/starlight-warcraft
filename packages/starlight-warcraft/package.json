{
  "name": "starlight-warcraft",
  "version": "0.2.0",
  "description": "A fantasy, Warcraft-inspired theme for Starlight, with React components forked from warcraftcn/ui.",
  "keywords": [
    "starlight",
    "starlight-plugin",
    "starlight-theme",
    "astro",
    "react",
    "warcraft",
    "theme"
  ],
  "homepage": "https://braden1996.github.io/starlight-warcraft/",
  "bugs": "https://github.com/Braden1996/starlight-warcraft/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Braden1996/starlight-warcraft.git",
    "directory": "packages/starlight-warcraft"
  },
  "license": "MIT",
  "author": "Braden Marshall",
  "sideEffects": ["**/*.css"],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./react": "./src/react/index.ts",
    "./styles/fonts.css": "./styles/fonts.css",
    "./styles/starlight.css": "./styles/starlight.css",
    "./styles/components.css": "./styles/components.css",
    "./styles/code.css": "./styles/code.css",
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "files": [
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "styles",
    "LICENSE-warcraftcn.md",
    "NOTICE.md"
  ],
  "scripts": {
    "typecheck": "tsrs -p tsconfig.src.json --noEmit && tsrs -p tsconfig.test.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@radix-ui/react-slot": "1.5.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.12",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.43.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": { "optional": true },
    "react": { "optional": true }
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
